# Copy to .env and fill in. .env is gitignored; never commit real keys.

# Anthropic API key for the tutor brain (required).
ANTHROPIC_API_KEY=sk-ant-...

# Only needed if [audio].tts_default = "openai" (Piper is the free local default).
# OPENAI_API_KEY=sk-...

# Optional overrides (defaults shown):
# FARIA_DATA_DIR=./data                # where faria.db lives
# FARIA_CONFIG=./config/default.toml   # tunables file
